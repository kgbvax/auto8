{
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin",
        "ref": "fbd794f329f5b65d0ea00a5e6487336c385ff2be"
      }
    }
  },
  "enabledPlugins": {
    "compound-engineering@compound-engineering-plugin": true,
    "simple-english@simple-english": false
  },
  "outputStyle": "simple-english",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/simple-english/lint_hook.py\"",
            "timeout": 10,
            "statusMessage": "Simple English: checking the file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/simple-english/lint_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
